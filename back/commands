schema save : 

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Show {
  id      Int      @id @default(autoincrement())
  label   String
  date    DateTime
  venueId Int
  venue   Venue    @relation(fields: [venueId], references: [id])
}

model Venue {
  id    Int    @id @default(autoincrement())
  name  String
  city  String
  shows Show[]
}
