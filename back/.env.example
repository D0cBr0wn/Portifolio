# Obligatoires
JWT_SECRET=                        # min 32 caractères aléatoires — générer avec :
                                   # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_URL=postgresql://ooodbuser:password@localhost:5432/ooo_db  # PostgreSQL via Docker (docker-compose up)
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175 # origines autorisées par CORS (séparées par virgule)

# Optionnelles — alertes email sur tentatives de connexion suspectes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
