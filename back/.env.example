# Obligatoires
JWT_SECRET=                        # min 32 caractères aléatoires — générer avec :
                                   # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_URL=file:./prisma/dev.db  # SQLite en dev ; PostgreSQL en prod : postgresql://user:pass@host:5432/db
FRONTEND_URL=http://localhost:5173 # origine autorisée par CORS

# Optionnelles — alertes email sur tentatives de connexion suspectes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
