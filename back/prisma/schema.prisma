generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma_client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Show {
  id      Int      @id @default(autoincrement())
  label   String
  date    DateTime
  venueId Int
  venue   Venue    @relation(fields: [venueId], references: [id])
}

model Venue {
  id    Int    @id @default(autoincrement())
  name  String
  city  String
  address1 String?
  address2 String?
  zipCode String?
  shows Show[]
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
}

model IpBan {
  ip        String   @id
  reason    String
  expiresAt DateTime
}

model FailedLoginAttempt {
  id      Int     @id @default(autoincrement())
  ip      String
  emailTried    String
  date    DateTime
}